{
  "name": "platform-db",
  "version": "0.2.5",
  "private": true,
  "description": "Shared PostgreSQL layer: adapter base class, SQL file loading, transactions, local scratch database tooling",
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": "./src/scripts/js/modules/index.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:database && npm run test:scheduler && npm run test:backup",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run format && npm run lint",
    "test:scheduler": "src/scripts/sh/local-db.sh run node src/scripts/js/modules/tests/query-scheduler-test.mjs",
    "test:database": "src/scripts/sh/local-db.sh run node src/scripts/js/modules/tests/postgres-database-test.mjs",
    "test:backup": "src/scripts/sh/local-db.sh run node src/scripts/js/modules/tests/table-backup-test.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
